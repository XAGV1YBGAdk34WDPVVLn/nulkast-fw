# Dockerized Stock Debian 6.x QEMU/KVM VM for Phase 4 tc CAKE SQM verification
# Reuses compiled nulkast-fw binary from nulkast-fw-lab:latest (zero host installs)
FROM nulkast-fw-lab:latest AS bin_src

FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    linux-image-amd64 \
    busybox-static \
    cpio \
    gzip \
    kmod \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bin_src /usr/local/bin/nulkast-fw /usr/local/bin/nulkast-fw
COPY lab/vm_init.sh /opt/vm_init.sh
COPY lab/vm_sqm_test.sh /usr/local/bin/vm_sqm_test.sh
RUN chmod +x /opt/vm_init.sh /usr/local/bin/vm_sqm_test.sh

# Build a minimal stock-Debian initramfs with real sch_cake/ifb/act_mirred modules + nulkast-fw
RUN set -eux; \
    KVER=$(ls /lib/modules | head -n1); \
    ROOT=/tmp/initrd; \
    mkdir -p "$ROOT/bin" "$ROOT/sbin" "$ROOT/usr/bin" "$ROOT/usr/sbin" "$ROOT/usr/local/bin" \
             "$ROOT/lib" "$ROOT/lib64" "$ROOT/proc" "$ROOT/sys" "$ROOT/dev" "$ROOT/etc" \
             "$ROOT/tmp" "$ROOT/var/lib/nulkast-fw"; \
    cp /bin/busybox "$ROOT/bin/busybox"; \
    for cmd in sh ash mount umount poweroff grep cat echo mkdir ls sleep uname; do \
        ln -sf busybox "$ROOT/bin/$cmd"; \
    done; \
    copy_with_libs() { \
        bin="$1"; dst="$ROOT$1"; \
        mkdir -p "$(dirname "$dst")"; \
        cp -L "$bin" "$dst"; \
        ldd "$bin" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^\//) print $i}' | while read -r lib; do \
            mkdir -p "$ROOT$(dirname "$lib")"; \
            cp -L "$lib" "$ROOT$lib" 2>/dev/null || true; \
        done; \
    }; \
    copy_with_libs /sbin/ip; \
    copy_with_libs /sbin/tc; \
    copy_with_libs /sbin/modprobe; \
    copy_with_libs /usr/local/bin/nulkast-fw; \
    mkdir -p "$ROOT/lib/modules/$KVER/kernel/net" "$ROOT/lib/modules/$KVER/kernel/drivers/net"; \
    cp -a "/lib/modules/$KVER/kernel/net/sched" "$ROOT/lib/modules/$KVER/kernel/net/"; \
    cp -a "/lib/modules/$KVER/kernel/drivers/net/ifb.ko"* "$ROOT/lib/modules/$KVER/kernel/drivers/net/"; \
    cp -a "/lib/modules/$KVER/kernel/drivers/net/dummy.ko"* "$ROOT/lib/modules/$KVER/kernel/drivers/net/"; \
    cp -a "/lib/modules/$KVER/modules."* "$ROOT/lib/modules/$KVER/" 2>/dev/null || true; \
    depmod -b "$ROOT" "$KVER"; \
    cp /opt/vm_init.sh "$ROOT/init"; \
    chmod +x "$ROOT/init"; \
    (cd "$ROOT" && find . | cpio -H newc -o | gzip -9 > /opt/initramfs.cpio.gz); \
    rm -rf "$ROOT"
